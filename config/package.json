{
  "name": "Eshopbox_Store",
  "version": "1.0.0",
  "config": {
    "theme": "src/app/themes/pantone-theme/config"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve  --aot",
    "build": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build:mobile": "npm run build:mobile-and-server-bundles ",
    "build:web": "npm run build:web-and-server-bundles ",
    "serve:ssr": "node dist/server.js",
    "copy-env": "cd src && rm -rf environments && cp -r app/themes/pantone-theme/config/src/environments environments && cd ..",
    "link-env": "cd src && rm -rf environments && ln -s -fn  app/themes/pantone-theme/config/src/environments environments && cd ..",
    "build:ssr": "npm run build:web-mobile-and-server-bundles ",
    "build-staging:ssr": "npm run build:web-mobile-and-server-bundles-staging",
    "compile_@agm_core": "babel node_modules/@agm/core -d node_modules/@agm/core --presets @babel/preset-env",
    "build:mobile-and-server-bundles": "ng run EshopBoxStore:mobile --configuration=mobprod && ng run EshopBoxStore:server-mobile -c mobprod && npm run webpack:mobile",
    "build:web-and-server-bundles": "ng build --configuration=production && ng run EshopBoxStore:server-web -c production && npm run webpack:web",
    "build:web-and-mobile-bundles": " npm run  copy-env && ng build --prod --configuration=production && ng run EshopBoxStore:mobile --configuration=mobprod && npm run link-env",
    "build:web-and-mobile-bundles-staging": " npm run  copy-env && ng build --aot && ng run EshopBoxStore:mobile --configuration=mob && npm run link-env ",
    "build:web-mobile-and-server-bundles": "npm run  copy-env && ng build --aot --prod   && ng run EshopBoxStore:mobile --configuration=mobprod && ng run EshopBoxStore:server-web -c production && ng run EshopBoxStore:server-mobile -c mobprod && npm run webpack:server  && npm run link-env",
    "build:web-mobile-and-server-bundles-staging": " ng build --aot  && ng run EshopBoxStore:mobile --configuration=mob && ng run EshopBoxStore:server-web && ng run EshopBoxStore:server-mobile -c mob && npm run webpack:server",
    "webpack:server": "webpack --config webpack.server.config.js --progress --colors",
    "webpack:mobile": "webpack --env=mobprod --config webpack.server.config.js --progress --colors",
    "webpack:web": "webpack --env=production --config webpack.server.config.js --progress --colors",
    "deploy": "firebase deploy --only functions",
    "postinstall": "npm run compile_@agm_core",
    "setup": "bash setup.sh",
    "husky": "npm install husky@next --save-dev",
    "post-build": "node ./build/post-build.js",
    "serve:ssr:dev": "concurrently 'ng build --configuration=production --watch=true' 'wait-on dist/web/index.html && ng run EshopBoxStore:server-web -c production --watch=true' 'wait-on dist/server-web/index.html && webpack --env=production --config webpack.server.config.js --watch' 'wait-on dist/server.js && node dist/server.js'"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && rm .gitlab-ci.yml && cp src/app/themes/pantone-theme/config/.gitlab-ci.yml .gitlab-ci.yml && git add .gitlab-ci.yml",
      "post-commit": "rm .gitlab-ci.yml && ln -s -fn  src/app/themes/pantone-theme/config/.gitlab-ci.yml .gitlab-ci.yml",
      "post-merge": "rm .gitlab-ci.yml && ln -s -fn  src/app/themes/pantone-theme/config/.gitlab-ci.yml .gitlab-ci.yml"
    }
  },
  "private": true,
  "dependencies": {
    "@agm/core": "1.0.0-beta.7",
    "@angular/animations": "~8.2.4",
    "@angular/cdk": "^8.1.4",
    "@angular/common": "~8.2.4",
    "@angular/compiler": "~8.2.4",
    "@angular/core": "~8.2.4",
    "@angular/fire": "^5.3.0",
    "@angular/forms": "~8.2.4",
    "@angular/material": "^8.2.3",
    "@angular/platform-browser": "~8.2.4",
    "@angular/platform-browser-dynamic": "~8.2.4",
    "@angular/platform-server": "^8.2.4",
    "@angular/pwa": "^0.803.23",
    "@angular/router": "~8.2.4",
    "@angular/service-worker": "^8.2.4",
    "@angular/upgrade": "^8.2.11",
    "@ngrx/effects": "^8.3.0",
    "@ngrx/router-store": "^8.3.0",
    "@ngrx/store": "^8.3.0",
    "@ngrx/store-devtools": "^8.3.0",
    "@ngu/carousel": "^1.5.5",
    "@nguniversal/express-engine": "^8.1.1",
    "@nguniversal/module-map-ngfactory-loader": "^8.1.1",
    "animate.css": "^3.7.0",
    "bootstrap": "^3.3.7",
    "compression": "^1.7.4",
    "contentful": "^7.13.1",
    "core-js": "^2.5.4",
    "express": "^4.16.4",
    "firebase-tools": "^7.12.1",
    "hammerjs": "^2.0.8",
    "install": "^0.12.2",
    "jquery": "^3.4.1",
    "mobile-detect": "^1.4.3",
    "ngx-cookie": "^4.0.2",
    "ngx-lazy-load-images": "^1.3.1",
    "ngx-owl-carousel": "^2.0.7",
    "ngx-pagination": "^5.0.0",
    "ngx-pinch-zoom": "^1.2.5",
    "npm": "^6.13.6",
    "puppeteer": "^1.20.0",
    "rxjs": "^6.5.2",
    "rxjs-compat": "^6.5.3",
    "schema-client": "^3.0.11",
    "zone.js": "~0.9.1",
    "ng-otp-input": "^1.7.1",
    "ngx-infinite-scroll": "9.0.0",
    "firebase-admin": "^8.3.0",
    "firebase-functions": "^3.2.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^0.803.23",
    "@angular/cli": "^8.3.23",
    "@angular/compiler-cli": "~8.2.4",
    "@angular/language-service": "~8.2.4",
    "@babel/cli": "^7.8.3",
    "@babel/core": "^7.8.3",
    "@babel/preset-env": "^7.8.3",
    "@types/googlemaps": "^3.39.2",
    "@types/jasmine": "~2.8.6",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "~8.9.4",
    "bufferutil": "^4.0.1",
    "codelyzer": "^5.0.1",
    "husky": "^4.0.10",
    "jasmine-core": "~2.99.1",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~1.7.1",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.0",
    "karma-jasmine": "~1.1.1",
    "karma-jasmine-html-reporter": "^0.2.2",
    "prettier": "^1.18.2",
    "pretty-quick": "^2.0.0",
    "protractor": "^5.4.2",
    "ts-loader": "^5.2.0",
    "ts-node": "~7.0.0",
    "tsconfig-paths-webpack-plugin": "^3.2.0",
    "tslint": "~5.11.0",
    "typescript": "3.5.3",
    "utf-8-validate": "^5.0.2",
    "webpack-cli": "^3.3.7",
    "webpack-dev-server": "^3.10.3",
    "ws": "^7.1.1",
    "xhr2": "^0.2.0"
  }
}
